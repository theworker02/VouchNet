# Required for server-side database access in local development.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
# Required for distributed rate limiting and ephemeral security state.
REDIS_URL=redis://REDIS_HOST:6379
# Used only for server-side structured logging identity.
NEXUS_ENV=development
# Minimum 32-character secret for server-side session signing when Wave B begins.
SESSION_SECRET=replace-with-a-unique-32-character-development-secret
# Server-only Resend credentials. Use onboarding@resend.dev only for early testing, then use a verified domain.
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=VouchNet <hello@YOUR_VERIFIED_DOMAIN>
# Public base URL used only to generate transactional-email links.
APP_URL=https://YOUR_PUBLIC_APP_URL
# Social sign-in providers. Register the exact callback URLs documented in docs/OAUTH.md.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
LINKEDIN_OAUTH_CLIENT_ID=replace-with-linkedin-oauth-client-id
LINKEDIN_OAUTH_CLIENT_SECRET=replace-with-linkedin-oauth-client-secret
# Used by VouchNet's future "Apply with VouchNet" OAuth/OIDC authorization server.
VOUCHNET_OAUTH_ISSUER=https://YOUR_PUBLIC_APP_URL
VOUCHNET_OAUTH_SIGNING_KEY=replace-with-a-separate-32-character-signing-secret
# Public Cloudflare Web Analytics site token. It is safe to expose in the client beacon.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=replace-with-cloudflare-web-analytics-token
